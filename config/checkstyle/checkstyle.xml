<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  conventions.md §2: turnbase-sdk is the one repository that runs Checkstyle, configured for
  exactly one rule — Javadoc on every public type — because that is the one thing
  google-java-format cannot check and this artifact's Javadoc is the documentation a
  third-party developer gets. Nothing else is enabled here: adding format rules would
  duplicate Spotless and start an argument (conventions.md §2).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>

  <module name="TreeWalker">
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
  </module>
</module>
