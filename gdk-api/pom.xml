<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    IMP-M3-03 (game-host-internals.md §3.6): this repository now builds two artifacts that
    share one version — the public GDK API (this module) and turnbase-serialization
    (../serialization). The reactor parent carries the version so `versions:set` at the root
    (as publish.yml already does) updates both in one step.
  -->
  <parent>
    <groupId>io.turnbase</groupId>
    <artifactId>turnbase-sdk-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>turnbase-sdk</artifactId>
  <packaging>jar</packaging>

  <name>turnbase-sdk</name>
  <description>Public Game Development Kit — the TurnBaseGame interface, effect/input types, and
    the TypeScript client, published for third-party game developers to compile against.</description>

  <!--
    Every version below is exact. conventions.md §6 requires reproducible builds, and a range
    or an inherited property is how the same commit compiles differently on Tuesday.

    No parent POM *across repositories*, matching turnbase-common: the five repositories are
    independently versioned and deployed (ADR-0012), and a shared parent would couple all five
    to a sixth artifact's release lifecycle for the sake of deduplicating configuration that is
    deliberately identical anyway. The reactor parent at ../pom.xml is intra-repo only — it
    exists to give this module and turnbase-serialization one version (IMP-M3-03), not to
    couple this repository to any other.
  -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependencies -->
    <jspecify.version>1.0.1</jspecify.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <!-- Plugins -->
    <spotless.version>3.10.0</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.1</nullaway.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <checkstyle.version>14.0.0</checkstyle.version>
    <jacoco.version>0.8.15</jacoco.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>

    <!--
      Coverage floor. platform-operations.md FR-CICD-003 sets 70% across unit and integration
      together. IMP-M3-01 lands the Effects factory, the result builders and GameOutcome's
      builder — the branching logic this floor now actually measures, rather than the vacuous
      pass IMP-M0-02 recorded here.
    -->
    <jacoco.line.coverage>0.70</jacoco.line.coverage>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The only compile dependency this artifact carries. @NullMarked is part of the
      published contract (ADR-0015, turnbase-sdk/CLAUDE.md) — a third-party developer's IDE
      and NullAway run both read it, so it travels with the jar rather than staying a
      build-only tool.
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Fail early and legibly on a wrong JDK or Maven, and — the one rule specific to this
        repository — on the two dependencies this artifact must never carry
        (turnbase-sdk/CLAUDE.md, IMP-M3-10's own Done-when): a game backend that needs
        turnbase-grpc or turnbase-game-host on its classpath means the GDK contract was not
        self-sufficient, and this is what makes that mechanical instead of a thing someone
        remembers to check.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!-- conventions.md §5: no SNAPSHOT dependency ever reaches a release. -->
                <requireReleaseDeps>
                  <onlyWhenRelease>true</onlyWhenRelease>
                </requireReleaseDeps>
                <!--
                  This artifact must have no dependency on turnbase-common or
                  turnbase-game-host, not even transitively (turnbase-sdk/CLAUDE.md). Banned
                  at every scope, because a `provided` or `test` escape hatch defeats the
                  point as thoroughly as a compile-scope one would.
                -->
                <bannedDependencies>
                  <excludes>
                    <exclude>io.turnbase:turnbase-grpc</exclude>
                    <exclude>io.turnbase:turnbase-game-host</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Spotless at validate, per conventions.md §2: seconds to fail, before compilation
        rather than after the test suite. The fix is ./mvnw spotless:apply.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Checkstyle. conventions.md §2: turnbase-sdk is the ONE repository that runs it, for
        the one rule a formatter cannot check — Javadoc on every public type
        (CLAUDE.md SHOULD, IMP-M0-02's own Done-when). Bound to validate, alongside Spotless,
        so a missing-Javadoc build fails at the same cheap point a formatting one does.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <configuration>
          <!-- config/ stays at the reactor root, shared by every module (conventions.md §2). -->
          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Error Prone + NullAway (ADR-0015). AnnotatedPackages is io.turnbase.gdk — the whole
        published surface, not a hand-written subset, because there is no generated code
        here to exclude.

        The two compilerArgs below (compilePolicy and should-stop) are required by Error
        Prone itself; without them the build fails in a way that reads as a broken toolchain.
        The add-exports/add-opens flags live in .mvn/jvm.config, because they must reach the
        JVM that forks javac.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- Required by Error Prone on JDK 21; it refuses to start without it. -->
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>-Xplugin:ErrorProne
              -Xep:NullAway:ERROR
              -XepOpt:NullAway:AnnotatedPackages=io.turnbase.gdk</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!--
        JaCoCo. conventions.md §3: unit and integration exec files are merged before a single
        check, because wiring one execution bound to test silently measures unit tests only
        and fails open. There is no integration tier here — nothing to containerise in an
        interfaces-only artifact — but the merge is wired anyway so the -Pintegration profile
        has somewhere to write and this pom does not differ in shape from the other three
        Java repositories.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-unit</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco/unit.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>merge-exec</id>
            <goals>
              <goal>merge</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}/jacoco</directory>
                  <includes>
                    <include>*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco/merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report-merged</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <dataFile>${project.build.directory}/jacoco/merged.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>check-merged</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <dataFile>${project.build.directory}/jacoco/merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Sources are published alongside the jar: a third-party developer's IDE reads Javadoc
        best when the source is attached.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>${maven-source-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      conventions.md §3: *IT runs under failsafe, only with -Pintegration. Empty of tests
      today; present so the invocation is identical across the Java repositories and so the
      exec file lands where the merge above expects it.
    -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-integration</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <destFile>${project.build.directory}/jacoco/integration.exec</destFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${maven-failsafe-plugin.version}</version>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Javadoc jar, release only: it is slow and adds nothing to the inner loop. doclint stays
      ON here, unlike turnbase-common — the Javadoc IS the documentation a third-party
      developer gets (turnbase-sdk/CLAUDE.md), so a broken @link should fail the release
      rather than ship silently malformed.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
